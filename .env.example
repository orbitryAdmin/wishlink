# PostgreSQL connection string
DATABASE_URL=postgresql://wishlist_studio:wishlist_studio@localhost:5432/wishlist_studio

# Cached product images live under ./data/images

# Used for share links and Open Graph metadata
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Manager login (set these on the server; generate AUTH_SECRET with `openssl rand -base64 32`)
# ADMIN_USERNAME=manager
# ADMIN_PASSWORD=replace-with-a-unique-password
# AUTH_SECRET=replace-with-the-output-of-openssl-rand-base64-32

# Optional: Gemini Flash enables normalization and review highlights
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
